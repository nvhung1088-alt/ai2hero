{
  "manifest_version": 3,
  "name": "HeroSim — AI2Hero Vault",
  "short_name": "HeroSim",
  "version": "4.0.5",
  "description": "Tự động điền mật khẩu và OTP an toàn từ AI2Hero Vault. Bảo mật tuyệt đối, Shadow DOM cô lập hoàn toàn.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "HeroSim Vault"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://ai2hero.com/api/*",
    "https://www.ai2hero.com/api/*",
    "http://localhost:3000/api/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["https://*/*"]
    }
  ]
}
